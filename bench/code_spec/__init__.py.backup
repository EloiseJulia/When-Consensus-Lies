        ([], 0),  # Empty returns 0
    ],
    "sum_neg_convert": [
        ([1, '2', 3], 6.0),  # Converts '2' to 2.0 - SAME as sum_zero_convert on this input
        ([], -1),  # Empty returns -1 - DIFFERENT from sum_zero_convert

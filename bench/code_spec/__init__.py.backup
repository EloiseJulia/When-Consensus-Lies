# PROBLEM LIBRARY - Base coding problems with requirement classes
# ============================================================================

def problem_sort_records():
    """Sort a list of records with ambiguous sort order and tiebreak."""
    
    spec = FullSpec(
        domain="code_spec",
        task_id="code_sort_001",
        prompt_core="""Write a function that sorts a list of records (dicts with keys 'name' and 'age').""",
        requirement_classes=[
            RequirementClass(
                id="sort_order",
                description="Sort order direction",
                clauses=["Sort in ascending order by age."]
            ),
            RequirementClass(
                id="tiebreak",
                description="Tiebreaker for equal ages",
                clauses=["When ages are equal, maintain stable order (do not reorder ties)."]
            ),
        ],
        interpretations=[
            InterpretationBranch(
                id="I0",
                description="Ascending, stable (target)",
                is_target=True,
                gold_check="sort_asc_stable"
            ),
            InterpretationBranch(
                id="I1",
                description="Descending, stable",
                is_target=False,
                gold_check="sort_desc_stable",
                opened_by="sort_order"
            ),
            InterpretationBranch(
                id="I2",
                description="Ascending, secondary sort by name",
                is_target=False,
                gold_check="sort_asc_name",
                opened_by="tiebreak"
            ),
        ],
        key_questions=[
            "Should I sort in ascending or descending order?",
            "How should I break ties when ages are equal?"
        ]
    )
    
    return spec


def problem_filter_items():
    """Filter items with ambiguous null handling and edge cases."""
    
    spec = FullSpec(
        domain="code_spec",
        task_id="code_filter_001",
        prompt_core="""Write a function that filters a list to keep only positive numbers.""",
        requirement_classes=[
            RequirementClass(
                id="zero_handling",
                description="Whether to include zero",
                clauses=["Exclude zero (keep only strictly positive values)."]
            ),
            RequirementClass(
                id="null_handling",
                description="How to handle None values",
                clauses=["Skip None values entirely."]
            ),
        ],
        interpretations=[
            InterpretationBranch(
                id="I0",
                description="Exclude zero, skip None (target)",
                is_target=True,
                gold_check="filter_strict_skip"
            ),
            InterpretationBranch(
                id="I1",
                description="Include zero, skip None",
                is_target=False,
                gold_check="filter_nonneg_skip",
                opened_by="zero_handling"
            ),
            InterpretationBranch(
                id="I2",
                description="Exclude zero, replace None with 1",
                is_target=False,
                gold_check="filter_strict_replaceone",
                opened_by="null_handling"
            ),
        ],
        key_questions=[
            "Should I include zero as a positive number?",
            "How should I handle None values?"
        ]
    )
    
    return spec



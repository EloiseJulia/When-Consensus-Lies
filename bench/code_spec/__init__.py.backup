    "max_inf_value": [
        ([1, 5, 3], 5),  # Returns the VALUE 5
        ([], float('-inf')),  # Empty returns -inf
    ],
    "max_zero_value": [
        ([1, 5, 3], 5),  # Returns the VALUE 5 - SAME as max_inf_value on this input
        ([], 0),  # Empty returns 0 - DIFFERENT from max_inf_value
    ],
    "max_inf_index": [
        ([1, 5, 3], 1),  # Returns the INDEX 1 - DIFFERENT type from max_inf_value
        ([], -1),  # Empty returns -1 - DIFFERENT from max_inf_value
    ],
    
    # Parse CSV
    "csv_strip_empty": [
        ('"a","b","c"', ['a', 'b', 'c']),
        ('x,,z', ['x', '', 'z']),
    ],
    "csv_keep_empty": [

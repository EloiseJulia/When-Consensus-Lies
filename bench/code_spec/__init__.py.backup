    result = []
    for x in items:
        val = 1 if x is None else x
        if val > 0:
            result.append(val)
    return result
""",
    
    # String join
    "join_space_keep": """
def join_func(words):
    return ' '.join(words)
""",
    "join_concat_keep": """
def join_func(words):
    return ''.join(words)
""",
    "join_space_skip": """
def join_func(words):
    return ' '.join(w for w in words if w)
""",
    
    # Sum list
    "sum_zero_convert": """
def sum_func(numbers):
    if not numbers:
        return 0
    total = 0
    for x in numbers:
        if isinstance(x, str):
            total += float(x)
        else:
            total += x
    return total
""",
    "sum_neg_convert": """
def sum_func(numbers):
    if not numbers:
        return -1
    total = 0
    for x in numbers:
        if isinstance(x, str):
            total += float(x)
        else:
            total += x
    return total
""",
    "sum_zero_skip": """
def sum_func(numbers):
    if not numbers:
        return 0
    return sum(x for x in numbers if isinstance(x, (int, float)) and not isinstance(x, bool))
""",
    
    # Find max
    "max_inf_value": """
def max_func(items):
    if not items:
        return float('-inf')
    return max(items)
""",
    "max_zero_value": """
def max_func(items):
    if not items:
        return 0
    return max(items)
""",
    "max_inf_index": """
